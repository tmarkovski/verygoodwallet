// Cloudflare Workers configuration for the landing site.
//
// Assets-only deployment: no Worker script — Cloudflare serves the static
// Vite build output from ./dist. Two real pages (/ and /writeup/), so no
// SPA fallback: unknown paths 404.
//
// Deploy: `wrangler deploy` from this directory (CI: .github/workflows/deploy-landing.yml).
{
  "name": "vgw-landing",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist"
  },
  // The apex custom domain re-asserts on every deploy (Cloudflare manages
  // DNS + cert). The initial attach — overriding the imported GitHub Pages
  // records — was done from the dashboard: the CI token (Workers Scripts →
  // Edit only) can create the domain record but not override existing DNS.
  // www is NOT a Worker domain: a dashboard redirect rule 301s it to the
  // apex, so declaring it here would clobber that rule on deploy.
  "routes": [{ "pattern": "verygoodwallet.com", "custom_domain": true }],
  // Explicit: declaring routes makes wrangler disable workers.dev by
  // default; keep the alias hostname serving.
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
