// Cloudflare Workers configuration for the Utopia DMV issuer.
//
// One deployable: the Hono Worker (OID4VCI + /api endpoints) plus the static
// DMV UI. @cloudflare/vite-plugin reads this file — `main` is the Worker
// entry vite builds, and the assets directory is filled in automatically at
// build time (the plugin snapshots this config into dist/, pointing at the
// client build; `wrangler deploy` picks that snapshot up).
//
// run_worker_first keeps the protocol + API routes on the Worker even if a
// static asset path ever shadowed them; everything else is served from
// assets, with SPA fallback for the single-page UI.
//
// Secrets (production): ISSUER_SEED, TOKEN_SECRET — see DEPLOY.md. Local dev
// falls back to hardcoded dev constants in worker/env.ts.
{
  "name": "vgw-dmv",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // Custom domain attaches on every deploy (Cloudflare manages DNS + cert).
  "routes": [{ "pattern": "dmv.verygoodwallet.com", "custom_domain": true }],
  // Explicit: declaring routes makes wrangler disable workers.dev by
  // default; keep the alias hostname serving.
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/oid4vci/*", "/.well-known/*", "/api/*"]
  },
  // THE revocation registry: one SQLite-backed Durable Object instance
  // holding the accumulator value, the epoch counter, the published update
  // log, and the issued-credential rows the admin page lists. The trapdoor
  // is NOT here — it derives from ISSUER_SEED in the Worker.
  "durable_objects": {
    "bindings": [{ "name": "REGISTRY", "class_name": "RevocationRegistry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RevocationRegistry"] }],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
